# ==============================================================================
# The Café Barrackpore — Environment Variables Example
# Copy this file to .env and provide your project values.
# NEVER commit the actual .env file with production credentials.
# ==============================================================================

# Sanity CMS (Public Project Configuration)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Supabase Foundation (Public Anonymous Client)
# Found under Project Settings > API in your Supabase Dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
