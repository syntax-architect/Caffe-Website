# ==============================================================================
# The Café Barrackpore — Commercial Production Environment Template
# Copy this file to .env for local/staging deployments.
# NEVER commit the actual .env or real secret keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT CONFIGURATION (Vite Browser Bundle)
# These variables are exposed to the browser. Only include public credentials.
# ------------------------------------------------------------------------------

# Supabase Anonymous Public Client (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Sanity CMS Public Configuration (sanity.io/manage)
VITE_SANITY_PROJECT_ID=your-sanity-project-id
VITE_SANITY_DATASET=production

# Custom Public Origin Override (Optional - defaults to window.location.origin)
# Use this when deploying behind a custom domain or reverse proxy for authoritative QR generation
# VITE_SITE_URL=https://www.restaurant.com

# Client-Safe Payment Gateway Identifiers (Optional - for hosted checkout flows)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_RAZORPAY_KEY_ID=rzp_test_...


# ------------------------------------------------------------------------------
# 2. SERVER & EDGE FUNCTION SECRETS (SERVER-SIDE ONLY)
# DO NOT prefix with VITE_. Never expose to client bundles or localStorage.
# Configure these directly in Supabase Dashboard (Project Settings > Edge Functions > Secrets)
# or your production backend environment.
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Database Admin / Atomic Server Mutations)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret

# Sanity CMS Write Token (For staff-authorized Sanity content mutation endpoint)
# SANITY_WRITE_TOKEN=sk...

# Stripe Payment Provider (Restaurant's Own Merchant Account)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay Payment Provider (Restaurant's Own Merchant Account)
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
